# Celery Worker Dockerfile
# Use same base as API but with Celery start command

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    gcc \
    libpython3-dev \
    libmagic1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .

# CACHE BUSTER: Change this value to force Railway to rebuild and install dependencies
# Last updated: 2026-01-05T16:45:00Z - FORCE GEVENT INSTALL
ARG CACHEBUST=2026010516450001

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    # Force install critical dependencies (bypass Docker cache)
    && pip install --no-cache-dir --force-reinstall gevent>=23.9.1 llama-parse>=0.5.0 nest_asyncio \
    && python -c "import gevent; print(f'✅ gevent {gevent.__version__} installed')" \
    && python -c "from llama_parse import LlamaParse; print('✅ LlamaParse installed successfully')"

# Copy application code
COPY . .

# Create non-root user for security (eliminates Celery's "running as root" warning)
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && chown -R appuser:appuser /app

USER appuser

# Run Celery worker
# concurrency=2 for memory safety, loglevel=info for visibility
CMD ["celery", "-A", "core.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
