# Celery Worker Dockerfile with ClamAV + start.sh (parity with web image)
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system dependencies (includes ClamAV + gosu)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    gcc \
    libpython3-dev \
    libmagic1 \
    libgl1 \
    libglib2.0-0 \
    clamav-daemon \
    clamav-freshclam \
    libclamav-dev \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Configure ClamAV to listen on TCP for instream scanning
RUN cat > /etc/clamav/clamd.conf <<'EOF' \
    && mkdir -p /var/log/clamav /var/run/clamav \
    && chown -R clamav:clamav /var/log/clamav /var/run/clamav
LogTime yes
LogVerbose yes
TCPSocket 3310
TCPAddr 127.0.0.1
Foreground yes
User clamav
AllowSupplementaryGroups yes
FixStaleSocket yes
LocalSocket /var/run/clamav/clamd.ctl
PidFile /var/run/clamav/clamd.pid
LogFile /var/log/clamav/clamav.log
StreamMaxLength 200M
MaxScanSize 500M
MaxFileSize 200M
EOF

# Update virus definitions during build (best effort)
RUN freshclam || true

# Install Python dependencies
COPY requirements.txt .

# CACHE BUSTER to force rebuilds when needed
ARG CACHEBUST=2026010516450001

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    # Force install critical dependencies (bypass Docker cache)
    && pip install --no-cache-dir --force-reinstall gevent>=23.9.1 \
    && python -c "import gevent; print(f'✅ gevent {gevent.__version__} installed')"

# Copy application code
COPY . .

# Start script to launch ClamAV before running worker
RUN chmod +x /app/start.sh || true

# Create non-root user (we drop privileges inside start.sh)
RUN groupadd -r appuser && useradd -r -g appuser appuser \
    && chown -R appuser:appuser /app

# Default command (overridden by Railway to use ./start.sh ...)
CMD ["/app/start.sh", "python", "-m", "celery", "-A", "core.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
