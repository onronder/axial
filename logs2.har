            "mimeType": "application/json",
            "text": "[{\"id\":\"a1b2c3d4-1111-4000-8000-000000000001\",\"type\":\"google_drive\",\"name\":\"Google Drive\",\"description\":\"Connect your Google Drive to import documents\",\"icon_path\":\"/icons/google-drive.svg\",\"category\":\"Cloud Storage\",\"is_active\":true},{\"id\":\"a1b2c3d4-2222-4000-8000-000000000002\",\"type\":\"notion\",\"name\":\"Notion\",\"description\":\"Import pages and databases from Notion\",\"icon_path\":\"/icons/notion.svg\",\"category\":\"Knowledge Base\",\"is_active\":true},{\"id\":\"a1b2c3d4-3333-4000-8000-000000000003\",\"type\":\"web\",\"name\":\"Web Scraper\",\"description\":\"Import content from any public URL\",\"icon_path\":\"/icons/web.svg\",\"category\":\"Web\",\"is_active\":true},{\"id\":\"a4c60470-ea12-4e5e-a641-8e973efcfc96\",\"type\":\"onedrive\",\"name\":\"OneDrive\",\"description\":\"Connect Microsoft OneDrive (personal or work) via Graph API\",\"icon_path\":null,\"category\":\"cloud\",\"is_active\":true},{\"id\":\"841b4924-4563-4055-89cf-f8fdf60e8a87\",\"type\":\"sharepoint\",\"name\":\"SharePoint\",\"description\":\"Connect Microsoft SharePoint sites via Graph API\",\"icon_path\":null,\"category\":\"cloud\",\"is_active\":true},{\"id\":\"836112c7-dd57-4740-9a98-d72df0e81b1c\",\"type\":\"dropbox\",\"name\":\"Dropbox\",\"description\":\"Connect to Dropbox to sync files and folders. Supports Personal and Business/Team accounts.\",\"icon_path\":\"/icons/dropbox.svg\",\"category\":\"Cloud Storage\",\"is_active\":true},{\"id\":\"896a97f6-af01-40c8-a217-557d203930be\",\"type\":\"github\",\"name\":\"GitHub\",\"description\":\"Connect to GitHub repositories to sync source code and documentation. Intelligent filtering excludes node_modules, build artifacts, and binaries.\",\"icon_path\":\"/icons/github.svg\",\"category\":\"Development\",\"is_active\":true},{\"id\":\"158ab2f5-8815-4f6c-9bf8-a17c3024c37c\",\"type\":\"box\",\"name\":\"Box\",\"description\":\"Connect to Box cloud storage for enterprise file management. Supports both personal and enterprise/business accounts with secure OAuth authentication.\",\"icon_path\":\"/icons/box.svg\",\"category\":\"Cloud Storage\",\"is_active\":true},{\"id\":\"80648e0f-79ac-488e-a56c-98394987415b\",\"type\":\"s3\",\"name\":\"Amazon S3\",\"description\":\"Connect to Amazon S3 buckets to import documents. Requires read-only IAM credentials with s3:ListBucket and s3:GetObject permissions.\",\"icon_path\":\"/icons/s3.svg\",\"category\":\"cloud\",\"is_active\":true},{\"id\":\"bf967dee-195f-4d3a-8c97-8cb65ecb0495\",\"type\":\"sftp\",\"name\":\"SFTP\",\"description\":\"Connect an SFTP server to import files securely\",\"icon_path\":null,\"category\":\"files\",\"is_active\":true}]"
