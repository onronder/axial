          "content": {
            "size": 1796,
            "mimeType": "application/json",
            "text": "[{\"id\":\"111b5954-9e1e-4ce7-b312-4bf4409c2c46\",\"name\":\"Axio Hub Starter\",\"description\":\"The perfect entry point for individuals building a personal second brain.\\n\\nIntelligence: Access to Axio Fast (Speed-optimized model).\\n\\nStorage: Upload up to 50 Files (100MB Total).\\n\\nFeatures: Semantic Search, Chat History, Secure Workspace.\\n\\nBest For: Students, Researchers, Hobbyists.\",\"price_amount\":499,\"price_currency\":\"usd\",\"interval\":\"month\",\"type\":\"starter\",\"features\":[\"100 queries/month\",\"2 connected sources\",\"Basic RAG search\",\"Community support\"],\"button_text\":\"Get Started\",\"button_variant\":\"outline\",\"popular\":false},{\"id\":\"7775ece3-a9ac-4fb6-8c4e-f0546b3a544c\",\"name\":\"Axio Hub Pro\",\"description\":\"For professionals and teams requiring deep analysis and larger capacity.\\n\\nIntelligence: Unlocks Axio Pro (Reasoning model) + Axio Fast.\\n\\nStorage: Massive capacity of 2,000 Files (10GB Total).\\n\\nFeatures:\\n\\nWeb Crawling: Chat with live websites.\\n\\nDeep Reasoning: Ask \\\"Why?\\\" and \\\"How?\\\", not just \\\"What?\\\".\\n\\nTeam Collaboration: Shared workspaces with role management.\\n\\nBest For: SMEs, Consultants, Legal & Engineering Teams.\",\"price_amount\":2900,\"price_currency\":\"usd\",\"interval\":\"month\",\"type\":\"pro\",\"features\":[\"Unlimited queries\",\"Unlimited sources\",\"Hybrid RAG + semantic\",\"Priority support\",\"API access\",\"Team sharing (3 seats)\"],\"button_text\":\"Start Free Trial\",\"button_variant\":\"default\",\"popular\":true},{\"id\":\"enterprise-contact-us\",\"name\":\"Enterprise\",\"description\":\"For organizations at scale\",\"price_amount\":0,\"price_currency\":\"usd\",\"interval\":\"\",\"type\":\"enterprise\",\"features\":[\"Everything in Pro\",\"SSO & SAML\",\"Custom integrations\",\"Dedicated support\",\"SLA guarantee\",\"On-premise option\"],\"button_text\":\"Contact Sales\",\"button_variant\":\"ghost\",\"popular\":false}]"
          },
