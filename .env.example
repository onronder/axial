# ==============================================================================
# Axial — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the required values.
# Variables marked [REQUIRED] must be set for the application to start.
# Variables marked [OPTIONAL] have sensible defaults.
#
# SECURITY: Never commit the .env file to version control.
# ==============================================================================

# ==============================================================================
# CORE / SUPABASE
# ==============================================================================

# [REQUIRED] Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# [REQUIRED] Supabase service_role key (backend only — never expose to frontend)
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# [REQUIRED] Supabase JWT secret for token verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# [OPTIONAL] Supabase anon/publishable key (for frontend usage)
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ==============================================================================
# AI / LLM PROVIDERS
# ==============================================================================

# [REQUIRED] OpenAI API key for embeddings and chat
OPENAI_API_KEY=sk-your-openai-api-key

# [REQUIRED] Internal API key for backend service authentication
API_KEY=your-internal-api-key

# [OPTIONAL] Primary model configuration
PRIMARY_MODEL_PROVIDER=openai
PRIMARY_MODEL_NAME=gpt-4o

# [OPTIONAL] Secondary model (used for fast/cheaper operations)
SECONDARY_MODEL_PROVIDER=openai
SECONDARY_MODEL_NAME=gpt-4o-mini

# [OPTIONAL] Guardrail model (used for intent classification)
GUARDRAIL_MODEL_PROVIDER=groq
GUARDRAIL_MODEL_NAME=llama-3.1-8b-instant

# [OPTIONAL] Groq API key (required if using Groq as guardrail provider)
GROQ_API_KEY=
GROQ_CHAT_MODEL_NAME=llama-3.3-70b-versatile

# [OPTIONAL] Grok (xAI) API key
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL_NAME=

# [OPTIONAL] LlamaParse for advanced OCR/PDF parsing
LLAMA_CLOUD_API_KEY=

# [OPTIONAL] Vision LLM for image/diagram understanding
VISION_LLM_ENABLED=false
VISION_LLM_PROVIDER=openai
VISION_LLM_MAX_IMAGE_SIZE=20971520

# [OPTIONAL] LLM safety settings
LLM_REQUEST_TIMEOUT=120
LLM_STREAM_TIMEOUT=60
LLM_MAX_CONCURRENT_REQUESTS=20
LLM_MAX_TOKENS_PER_REQUEST=50000
LLM_HEARTBEAT_INTERVAL=10.0
LLM_LOAD_BALANCE=false

# ==============================================================================
# GOOGLE OAUTH (Google Drive connector)
# ==============================================================================

# [OPTIONAL] Required for Google Drive integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

# ==============================================================================
# NOTION OAUTH
# ==============================================================================

# [OPTIONAL] Required for Notion integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/oauth/callback

# ==============================================================================
# MICROSOFT OAUTH (OneDrive / SharePoint)
# ==============================================================================

# [OPTIONAL] Required for OneDrive and SharePoint integrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/oauth/callback
MICROSOFT_TENANT_ID=common
MICROSOFT_SCOPES_ONEDRIVE=offline_access User.Read Files.Read.All
MICROSOFT_SCOPES_SHAREPOINT=offline_access User.Read Files.Read.All Sites.Read.All

# ==============================================================================
# DROPBOX OAUTH
# ==============================================================================

# [OPTIONAL] Required for Dropbox integration
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:3000/oauth/callback

# ==============================================================================
# GITHUB OAUTH
# ==============================================================================

# [OPTIONAL] Required for GitHub integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/oauth/callback

# ==============================================================================
# BOX OAUTH
# ==============================================================================

# [OPTIONAL] Required for Box integration
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=http://localhost:3000/oauth/callback

# ==============================================================================
# REDIS
# ==============================================================================

# [OPTIONAL] Redis connection URL (default: localhost for development)
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_COUNTER_TTL_SECONDS=86400
REDIS_JOB_FINALIZE_TTL_SECONDS=3600
REDIS_JOB_PROGRESS_UPDATE_BATCH=10
REDIS_JOB_PROGRESS_UPDATE_INTERVAL=30

# ==============================================================================
# GHOST PROTOCOL — Zero-Retention Security
# ==============================================================================

# [CRITICAL in production] AES-256 encryption key for document chunks at rest.
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# BACK THIS KEY UP — losing it means losing all encrypted data.
CHUNK_ENCRYPTION_KEY=

# [OPTIONAL] General encryption key for other sensitive data
ENCRYPTION_KEY=

# [OPTIONAL] Crash on unencrypted content retrieval (true for greenfield deployments)
STRICT_ENCRYPTION_MODE=true

# [OPTIONAL] Secure wipe passes (1=fast, 3=DoD 5220.22-M compliant)
SECURE_WIPE_PASSES=3
SECURE_WIPE_PATTERN=dod_5220_22_m
SECURE_WIPE_VERIFY=true

# [OPTIONAL] Memory processing threshold — files below this use RAM, above use disk
MAX_RAM_PROCESS_LIMIT=10485760

# ==============================================================================
# EMAIL (Resend)
# ==============================================================================

# [OPTIONAL] Required for sending transactional emails
RESEND_API_KEY=
EMAILS_FROM_EMAIL=noreply@axiohub.io

# ==============================================================================
# APPLICATION
# ==============================================================================

# [OPTIONAL] Public-facing application URL
APP_URL=https://app.axiohub.io
LOGO_URL=https://raw.githubusercontent.com/onronder/axial/main/frontend-new/public/assets/axio-hub-full-light.png

# [OPTIONAL] CORS origins (comma-separated). Empty = allow configured frontend only.
ALLOWED_ORIGINS=

# [OPTIONAL] Environment name (development | staging | production)
ENVIRONMENT=development

# ==============================================================================
# ERROR TRACKING (Sentry)
# ==============================================================================

# [OPTIONAL] Sentry DSN for error tracking
SENTRY_DSN=

# ==============================================================================
# RATE LIMITING
# ==============================================================================

# [OPTIONAL] Default rate limit for API endpoints
RATE_LIMIT_DEFAULT=50/minute

# ==============================================================================
# CELERY WORKER CONFIGURATION
# ==============================================================================

# [OPTIONAL] Soft/hard time limits for Celery tasks (seconds)
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=1200

# [OPTIONAL] Worker memory management (for 8-core/32GB enterprise nodes)
CELERY_WORKER_MAX_MEMORY_PER_CHILD=3000000
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_CONCURRENCY=8

# ==============================================================================
# RESOURCE LIMITS
# ==============================================================================

# [OPTIONAL] Maximum upload file size (bytes). Default: 100MB
MAX_FILE_SIZE=104857600
MAX_STRUCTURED_FILE_SIZE=52428800

# [OPTIONAL] Malware scanning
MALWARE_SCAN_MAX_BYTES=1073741824
# Reject uploads when ClamAV is unavailable (auto-enabled in production)
MALWARE_SCAN_FAIL_CLOSED=false
# Skip ClamAV update on dev for faster startup
SKIP_FRESHCLAM=true

# [OPTIONAL] Chunking and embedding
MAX_CHUNK_BATCH_SIZE=100
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_TOKENS_PER_REQUEST=250000
EMBEDDING_SLEEP_INTERVAL=0.5
EMBEDDING_MAX_CONCURRENCY=3
CHUNK_INSERT_BATCH_SIZE=100
EMBEDDING_ADAPTIVE_LATENCY_FACTOR=0.05
EMBEDDING_ADAPTIVE_MAX_SLEEP=2.0
EMBEDDING_RATE_LIMIT_BACKOFF_STEP=0.5
EMBEDDING_RATE_LIMIT_BACKOFF_MAX=5.0
EMBEDDING_RATE_LIMIT_DECAY=0.25

# [OPTIONAL] Memory thresholds for worker auto-scaling
MEMORY_WARNING_THRESHOLD=0.85
MEMORY_CRITICAL_THRESHOLD=0.95

# [OPTIONAL] Parser timeouts (seconds)
TEXT_PARSE_TIMEOUT=60
PDF_PARSE_TIMEOUT=300
PDF_PARSE_TIMEOUT_OCR=600

# [OPTIONAL] RAG similarity threshold
RAG_SIMILARITY_THRESHOLD=0.35

# ==============================================================================
# GUARDRAILS PRE-FLIGHT SEARCH
# ==============================================================================

GUARDRAIL_PREFLIGHT_ENABLED=true
GUARDRAIL_PREFLIGHT_THRESHOLD=0.35
GUARDRAIL_PREFLIGHT_MATCH_COUNT=3
GUARDRAIL_PREFLIGHT_MIN_MATCHES=1

# ==============================================================================
# CONNECTOR CONCURRENCY LIMITS
# ==============================================================================

CONNECTOR_CONCURRENCY_DEFAULT=2
CONNECTOR_CONCURRENCY_GOOGLE_DRIVE=2
CONNECTOR_CONCURRENCY_NOTION=1
CONNECTOR_CONCURRENCY_WEB=2
CONNECTOR_CONCURRENCY_ONEDRIVE=2
CONNECTOR_CONCURRENCY_SHAREPOINT=2
CONNECTOR_CONCURRENCY_DROPBOX=2
CONNECTOR_CONCURRENCY_GITHUB=2
CONNECTOR_CONCURRENCY_BOX=2
CONNECTOR_CONCURRENCY_S3=4
CONNECTOR_CONCURRENCY_SFTP=2

# ==============================================================================
# YOUTUBE / BRIGHT DATA
# ==============================================================================

# [OPTIONAL] Required for YouTube transcript fetching from cloud infrastructure
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=axio_unlocker
BRIGHTDATA_TIMEOUT=60
BRIGHTDATA_RETRY_COUNT=3
BRIGHTDATA_RETRY_DELAY=2.0

# [DEPRECATED] Legacy proxy settings
YOUTUBE_PROXY_URL=
YOUTUBE_PROXY_ENABLED=false
YOUTUBE_PROXY_TIMEOUT=30
YOUTUBE_PROXY_RETRY_COUNT=3
YOUTUBE_PROXY_RETRY_DELAY=1.0
YOUTUBE_DIRECT_FALLBACK=true

# ==============================================================================
# COMMERCIALIZATION & TIER LIMITS
# ==============================================================================

MODEL_ALIAS_FAST=fast
MODEL_ALIAS_SMART=smart

LIMITS_STARTER_FILES=50
LIMITS_PRO_FILES=2000
LIMITS_STARTER_SCOPES=5
LIMITS_PRO_SCOPES=100
LIMITS_ENTERPRISE_SCOPES=1000
LIMITS_STARTER_MB=100
LIMITS_PRO_MB=10240
LIMITS_STARTER_LLM_TOKENS=1000000
LIMITS_PRO_LLM_TOKENS=10000000
LIMITS_ENTERPRISE_LLM_TOKENS=100000000

# ==============================================================================
# PAYMENT INTEGRATION (Polar.sh)
# ==============================================================================

# [OPTIONAL] Required for billing/subscription features
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_WEBHOOK_SECRET=

# [OPTIONAL] Polar product IDs for subscription tiers
POLAR_PRODUCT_ID_STARTER_MONTHLY=
POLAR_PRODUCT_ID_PRO_MONTHLY=
POLAR_PRODUCT_ID_ENTERPRISE=

# ==============================================================================
# DATABASE (Optional least-privilege ingestion)
# ==============================================================================

# [OPTIONAL] Dedicated DB URL for least-privilege ingestion role
INGESTION_DATABASE_URL=

# ==============================================================================
# FRONTEND (Next.js public variables — must start with NEXT_PUBLIC_)
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
